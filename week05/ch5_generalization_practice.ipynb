{"cells":[{"cell_type":"markdown","metadata":{},"source":["# Week 5: Generalization Practice\n","\n","This notebook collects the classroom exercises on noisy features, model capacity, dropout, and learning rate."]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["import keras\n","from keras import layers\n","from keras.datasets import mnist\n","import matplotlib.pyplot as plt\n","import numpy as np\n","\n","np.random.seed(42)"]},{"cell_type":"markdown","metadata":{},"source":["## 1. MNIST with noise channels, zero channels, and original features"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["(train_images, train_labels), _ = mnist.load_data()\n","train_images = train_images.reshape((60000, 28 * 28))\n","train_images = train_images.astype("float32") / 255\n","\n","train_images_with_noise_channels = np.concatenate(\n","    [train_images, np.random.random((len(train_images), 784))], axis=1\n",")\n","train_images_with_zeros_channels = np.concatenate(\n","    [train_images, np.zeros((len(train_images), 784))], axis=1\n",")"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["def get_mnist_model():\n","    model = keras.Sequential(\n","        [\n","            layers.Dense(512, activation="relu"),\n","            layers.Dense(10, activation="softmax"),\n","        ]\n","    )\n","    model.compile(\n","        optimizer="adam",\n","        loss="sparse_categorical_crossentropy",\n","        metrics=["accuracy"],\n","    )\n","    return model"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["model = get_mnist_model()\n","history_noise = model.fit(\n","    train_images_with_noise_channels,\n","    train_labels,\n","    epochs=10,\n","    batch_size=128,\n","    validation_split=0.2,\n",")\n","\n","model = get_mnist_model()\n","history_zeros = model.fit(\n","    train_images_with_zeros_channels,\n","    train_labels,\n","    epochs=10,\n","    batch_size=128,\n","    validation_split=0.2,\n",")\n","\n","model = get_mnist_model()\n","history_original_mnist = model.fit(\n","    train_images,\n","    train_labels,\n","    epochs=10,\n","    batch_size=128,\n","    validation_split=0.2,\n",")"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["val_acc_noise = history_noise.history["val_accuracy"]\n","val_acc_zeros = history_zeros.history["val_accuracy"]\n","val_acc_original = history_original_mnist.history["val_accuracy"]\n","epochs = range(1, 11)\n","\n","plt.plot(epochs, val_acc_noise, "b-", label="Noise channels")\n","plt.plot(epochs, val_acc_zeros, "b--", label="Zero channels")\n","plt.plot(epochs, val_acc_original, "r--", label="Original data")\n","plt.title("MNIST validation accuracy comparison")\n","plt.xlabel("Epochs")\n","plt.ylabel("Validation accuracy")\n","plt.xticks(epochs)\n","plt.legend()\n","plt.show()"]},{"cell_type":"markdown","metadata":{},"source":["## 2. Learning rate comparison: 1.0 and 0.01"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["def train_with_learning_rate(learning_rate):\n","    model = keras.Sequential(\n","        [\n","            layers.Dense(512, activation="relu"),\n","            layers.Dense(10, activation="softmax"),\n","        ]\n","    )\n","    model.compile(\n","        optimizer=keras.optimizers.RMSprop(learning_rate=learning_rate),\n","        loss="sparse_categorical_crossentropy",\n","        metrics=["accuracy"],\n","    )\n","    return model.fit(\n","        train_images,\n","        train_labels,\n","        epochs=10,\n","        batch_size=128,\n","        validation_split=0.2,\n","    )"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["history_lr_1 = train_with_learning_rate(1.0)\n","history_lr_001 = train_with_learning_rate(0.01)"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["epochs = range(1, 11)\n","plt.plot(epochs, history_lr_1.history["val_accuracy"], "r--", label="Learning rate = 1.0")\n","plt.plot(epochs, history_lr_001.history["val_accuracy"], "b-", label="Learning rate = 0.01")\n","plt.title("Effect of learning rate on MNIST validation accuracy")\n","plt.xlabel("Epochs")\n","plt.ylabel("Validation accuracy")\n","plt.xticks(epochs)\n","plt.legend()\n","plt.show()"]},{"cell_type":"markdown","metadata":{},"source":["## 3. Original, lower-capacity, and larger-capacity models"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["from keras.datasets import imdb\n","\n","(train_data, train_labels), _ = imdb.load_data(num_words=10000)\n","\n","def vectorize_sequences(sequences, dimension=10000):\n","    results = np.zeros((len(sequences), dimension))\n","    for i, sequence in enumerate(sequences):\n","        results[i, sequence] = 1.0\n","    return results\n","\n","train_data = vectorize_sequences(train_data)"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["def train_imdb_model(hidden_units, use_dropout=False):\n","    model_layers = [layers.Dense(hidden_units, activation="relu")]\n","    if use_dropout:\n","        model_layers.append(layers.Dropout(0.5))\n","    model_layers.append(layers.Dense(hidden_units, activation="relu"))\n","    if use_dropout:\n","        model_layers.append(layers.Dropout(0.5))\n","    model_layers.append(layers.Dense(1, activation="sigmoid"))\n","\n","    model = keras.Sequential(model_layers)\n","    model.compile(\n","        optimizer="rmsprop",\n","        loss="binary_crossentropy",\n","        metrics=["accuracy"],\n","    )\n","    return model.fit(\n","        train_data,\n","        train_labels,\n","        epochs=20,\n","        batch_size=512,\n","        validation_split=0.4,\n","    )"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["history_original = train_imdb_model(16)\n","history_smaller_model = train_imdb_model(4)\n","history_larger_model = train_imdb_model(512)"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["epochs = range(1, 21)\n","plt.plot(epochs, history_original.history["val_loss"], "r--", label="Original model")\n","plt.plot(epochs, history_smaller_model.history["val_loss"], "g-", label="Lower-capacity model")\n","plt.plot(epochs, history_larger_model.history["val_loss"], "b-", label="Larger-capacity model")\n","plt.title("Validation loss comparison of model capacities")\n","plt.xlabel("Epochs")\n","plt.ylabel("Validation loss")\n","plt.xticks(epochs)\n","plt.legend()\n","plt.show()"]},{"cell_type":"markdown","metadata":{},"source":["## 4. Original model and dropout-regularized model"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["history_dropout = train_imdb_model(16, use_dropout=True)"]},{"cell_type":"code","execution_count":null,"metadata":{},"outputs":[],"source":["epochs = range(1, 21)\n","plt.plot(epochs, history_original.history["val_loss"], "r--", label="Original model")\n","plt.plot(epochs, history_dropout.history["val_loss"], "b-", label="Dropout-regularized model")\n","plt.title("Original model vs. dropout-regularized model")\n","plt.xlabel("Epochs")\n","plt.ylabel("Validation loss")\n","plt.xticks(epochs)\n","plt.legend()\n","plt.show()"]}],"metadata":{"colab":{"name":"ch5_generalization_practice.ipynb","provenance":[]},"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3"}},"nbformat":4,"nbformat_minor":5}
